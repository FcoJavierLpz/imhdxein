---
export const prerender = true;

import DoshaQuiz from '../components/DoshaQuiz.vue';
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout
  title="Test de dosha ayurvédico gratuito"
  description="Responde el test de dosha gratuito y descubre si tu constitución es Vata, Pitta o Kapha, con recomendaciones personalizadas para tu bienestar."
>
  <section class="relative py-20 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-spirit-800 via-brand-900 to-deep-900"></div>
    <div class="absolute inset-0 lotus-bg opacity-20"></div>
    <div class="container-custom px-4 relative z-10">
      <div class="max-w-3xl">
        <h1 class="text-4xl md:text-5xl font-heading font-bold text-white">
          Test de <span class="headline-accent">Dosha</span>
        </h1>
        <p class="mt-6 text-brand-100 text-lg leading-relaxed">
          Descubre gratis tu constitución Ayurvédica (Prakriti) y recibe recomendaciones personalizadas
          para equilibrar cuerpo, mente y energía.
        </p>
      </div>
    </div>
  </section>
  <div class="h-1.5 chakra-gradient"></div>

  <DoshaQuiz client:load />
</MainLayout>
