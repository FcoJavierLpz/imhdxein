---
export const prerender = true;

import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { CONTACT_WHATSAPP_PHONE } from '../../constants/contact';

export async function getStaticPaths() {
  const therapists = await getCollection('therapists');

  return therapists.map((therapist) => ({
    params: { slug: therapist.id },
    props: { therapist },
  }));
}

const { therapist } = Astro.props;
const { name, title, specialty, bio, image, isActive } = therapist.data;

const toTitleCase = (text: string) =>
  text
    .trim()
    .toLowerCase()
    .replace(/(^|[\s.'-])\S/g, (c) => c.toUpperCase());

const displayName = toTitleCase(name);
const displayTitle = toTitleCase(title);

const bioLines = bio
  .split('\n')
  .map((line) => line.trim())
  .filter(Boolean);
const hasCredentialList = bioLines.length > 1;

const credentialAccents = [
  { bg: 'bg-brand-100', text: 'text-brand-600' },
  { bg: 'bg-sage-100', text: 'text-sage-600' },
  { bg: 'bg-spirit-100', text: 'text-spirit-600' },
];

const whatsappMessage =
  `Hola!, me gustaría agendar una consulta con *${displayName}* ` +
  `(${specialty}). ¿Me podrían dar más información sobre disponibilidad?`;
const whatsappUrl = `https://wa.me/${CONTACT_WHATSAPP_PHONE}?text=${encodeURIComponent(whatsappMessage)}`;
---

<MainLayout
  title={`${displayName} - Equipo IMHDXEIN`}
  description={`${displayTitle} · ${specialty}. Conoce la formación y trayectoria de ${displayName} en IMHDXEIN, Instituto de Medicina Holística.`}
  image={image?.src}
>
  <div class="h-1.5 chakra-gradient"></div>
  <article class="section-padding bg-white">
    <div class="container-custom max-w-5xl">
      <a href="/nosotros" class="text-brand-600 hover:text-brand-700 font-medium text-sm mb-8 flex items-center gap-1">&larr; Volver al Equipo</a>

      <div class="mt-6 grid md:grid-cols-2 gap-10 items-start">
        <div class="rounded-2xl overflow-hidden shadow-lg md:sticky md:top-28">
          {image ? (
            <Image src={image} alt={displayName} class="w-full aspect-[4/5] object-cover object-top" />
          ) : (
            <div class="w-full aspect-[4/5] flex flex-col items-center justify-center gap-3 bg-gradient-to-br from-brand-50 via-white to-spirit-50">
              <div class="w-20 h-20 rounded-full bg-white flex items-center justify-center shadow-sm">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-brand-300" aria-hidden="true">
                  <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
                </svg>
              </div>
              <span class="text-xs font-medium uppercase tracking-wide text-deep-400">Foto próximamente</span>
            </div>
          )}
        </div>

        <div class="flex flex-col">
          <span class="text-xs text-brand-600 font-medium uppercase tracking-wide">{specialty}</span>
          <h1 class="mt-2 text-3xl md:text-4xl font-heading font-bold text-deep-900 leading-tight">{displayName}</h1>
          <p class="mt-2 text-lg font-heading font-semibold text-spirit-600">{displayTitle}</p>

          {hasCredentialList ? (
            <div class="mt-8">
              <h2 class="font-heading font-semibold text-deep-800 text-lg mb-4">Formación y Credenciales</h2>
              <ul class="space-y-2.5">
                {bioLines.map((line, i) => {
                  const accent = credentialAccents[i % credentialAccents.length];
                  return (
                    <li class="flex items-start gap-3 rounded-xl bg-deep-50/60 p-3">
                      <div class={`mt-0.5 w-8 h-8 rounded-lg ${accent.bg} flex items-center justify-center shrink-0`}>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={accent.text} aria-hidden="true">
                          <path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/>
                        </svg>
                      </div>
                      <p class="text-sm text-deep-700 leading-relaxed">{line}</p>
                    </li>
                  );
                })}
              </ul>
            </div>
          ) : (
            <div class="mt-8">
              <h2 class="font-heading font-semibold text-deep-800 text-lg mb-3">Trayectoria</h2>
              <p class="text-deep-600 leading-relaxed whitespace-pre-line">{bio}</p>
            </div>
          )}

          {!isActive && (
            <p class="mt-6 text-sm text-deep-400 italic">Actualmente no forma parte del equipo activo.</p>
          )}

          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-10 w-full flex items-center justify-center gap-2 rounded-xl py-3.5 text-base font-semibold text-white transition-all duration-200 hover:shadow-lg hover:brightness-110 active:scale-95"
            style="background-color: #25D366;"
            aria-label={`Agendar consulta con ${displayName} por WhatsApp`}
          >
            <svg width="18" height="18" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
              <path fill="currentColor" d="M16.004 3C9.377 3 4 8.373 4 15c0 2.362.687 4.564 1.872 6.415L4 29l7.767-1.83A11.94 11.94 0 0 0 16.004 27C22.63 27 28 21.627 28 15S22.63 3 16.004 3Zm0 21.818a9.77 9.77 0 0 1-4.98-1.366l-.357-.212-4.61 1.087 1.104-4.49-.234-.367A9.76 9.76 0 0 1 5.2 15c0-5.966 4.847-10.818 10.804-10.818S26.809 9.034 26.809 15 21.961 24.818 16.004 24.818Zm5.61-7.98c-.307-.154-1.816-.897-2.098-1-.28-.103-.485-.154-.688.154-.204.307-.79 1-.968 1.205-.178.205-.357.23-.663.077-.307-.154-1.296-.478-2.468-1.523-.912-.813-1.528-1.817-1.707-2.124-.178-.307-.019-.473.135-.626.139-.138.307-.359.46-.538.154-.18.205-.308.307-.513.103-.205.051-.384-.026-.538-.077-.154-.688-1.659-.943-2.272-.248-.596-.5-.516-.688-.526l-.586-.01c-.205 0-.538.077-.82.384-.28.307-1.07 1.046-1.07 2.551 0 1.505 1.096 2.96 1.249 3.164.153.205 2.157 3.294 5.228 4.62.73.315 1.3.503 1.744.643.733.233 1.4.2 1.928.121.588-.088 1.816-.742 2.072-1.459.256-.717.256-1.331.18-1.459-.077-.128-.281-.205-.588-.359Z"/>
            </svg>
            Agendar Consulta por WhatsApp
          </a>
          <p class="mt-3 text-center text-xs text-deep-400">Al agendar, nuestro equipo confirmará contigo la fecha y modalidad de tu consulta.</p>
        </div>
      </div>
    </div>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": displayName,
    "jobTitle": displayTitle,
    "description": bio,
    ...(image ? { "image": new URL(image.src, Astro.site).toString() } : {}),
    "worksFor": {
      "@type": "MedicalOrganization",
      "name": "IMHDXEIN",
    },
  })} />
</MainLayout>
